# Keep the software-only policy if another component changes the saved value.
# The false-only trigger cannot loop when the value is restored to true.
on property:persist.bluetooth.a2dp_offload.disabled=false
    setprop persist.bluetooth.a2dp_offload.disabled true

service s10-user-defaults /system/bin/sh /system/etc/s10-user-defaults.sh
    class late_start
    user shell
    group shell
    seclabel u:r:shell:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    start s10-user-defaults
